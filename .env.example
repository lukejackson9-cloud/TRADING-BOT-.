# Trading 212 — OPTIONAL. Advisory-only mode (see CLAUDE.md) never calls
# the T212 API, so you can leave these unset. Only fill in both if you
# later decide to connect a real account for live/paper execution.
# Generate keys in the app under Settings > API — click "Switch to
# Practice" FIRST if you want DEMO/paper keys instead of live ones.
T212_API_KEY=your_t212_api_key
T212_API_SECRET=your_t212_api_secret
T212_BASE_URL=https://demo.trading212.com/api/v0

# Unused — screening/research runs on Claude Code's built-in WebSearch
# tool instead, so there's no Perplexity subscription to pay for. Leave
# this unset; scripts/perplexity_client.py is dead code kept for reference.
PERPLEXITY_API_KEY=your_perplexity_key

# Optional — only needed if you want the daily digest posted to ClickUp.
CLICKUP_API_TOKEN=your_clickup_token

# Recommended — a real market screener (Financial Modeling Prep), so
# screen.md can query the whole market by price/volume/sector instead of
# guessing at WebSearch terms. Free tier: https://site.financialmodelingprep.com/developer/docs
# Note: needs this environment's network access to allow
# financialmodelingprep.com, same as T212/Perplexity/ClickUp above.
FMP_API_KEY=your_fmp_api_key

# Recommended once network access allows it (see HANDOFF.md) — Massive.com
# (formerly Polygon.io) gives a genuine whole-market screen in one API call
# (scripts/massive_client.py), unlike FMP's free tier which only exposes a
# curated top-50 gainers/losers list. Free tier: https://massive.com
# Needs api.massive.com AND api.polygon.io allowed on this environment's
# network policy — both were blocked as of 2026-09-03.
MASSIVE_API_KEY=your_massive_api_key

# Recommended for skills/monitor.md — Alpaca Markets gives genuine
# real-time (not end-of-day) US equity quotes on its free tier, unlike
# FMP/Massive which are both EOD-only. Free tier is IEX-exchange-only
# (~2-4% of a stock's volume), not the full consolidated tape -- good
# enough to catch a stop/target approach, not execution-grade precision
# (moot here, this project has no execution path anyway).
# Sign up free at https://alpaca.markets -> dashboard -> API Keys.
# Paper-account keys work fine; this project only ever reads quotes.
ALPACA_API_KEY=your_alpaca_api_key_id
ALPACA_API_SECRET=your_alpaca_api_secret

# Optional — scripts/tradingview_alerts_client.py reads TradingView webhook
# alerts relayed through a Zapier bridge (TradingView alert -> Zapier
# "Catch Hook" -> Zapier "Google Sheets: Create Spreadsheet Row" -> a
# Sheet published to the web as CSV). Paste the published-CSV URL here
# once that's set up on your end — see HANDOFF.md's 2026-09-07 entry for
# the full step-by-step. No Google auth needed; "publish to web" makes
# the URL public but unguessable, which is why no separate credential
# exists for this one.
TRADINGVIEW_ALERTS_CSV_URL=your_published_google_sheet_csv_url
